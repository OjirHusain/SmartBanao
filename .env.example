# ==============================================================================
# SMARTBANAO ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server & Application URL
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Cryptographic Token Signing Secret (Keep private on server)
JWT_SECRET="replace_with_a_secure_random_64_character_string"

# Supabase PostgreSQL Database & Auth (Optional for Supabase Cloud integration)
# Get these from: Supabase Dashboard -> Project Settings -> API & Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres"

# Indian Payment Gateway: Razorpay
# Keep payment secrets securely on the server!
# Get these from: Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
